# Maintainer: bstar <https://github.com/bstar>
#
# Repackages the pacman package attached to each STAR/FOLD release, so this
# recipe builds nothing. The source-built recipe ships as PKGBUILD with every
# release, and the signed [star] repository carries the same package.
pkgname=starfold-bin
_pkgname=starfold
pkgver=0.0.2
pkgrel=1
pkgdesc='A stack-based terminal file manager in the STAR family'
arch=('x86_64')
url='https://github.com/bstar/starfold'
license=('MIT' 'LicenseRef-UnRAR')
depends=('glibc' 'gcc-libs')
optdepends=('xdg-utils: open files with desktop applications'
            'libvips: thumbnail very large images')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!strip' '!debug')
noextract=("$_pkgname-$pkgver-1-x86_64.pkg.tar.zst")
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-1-x86_64.pkg.tar.zst")
sha256sums=('796f47454496b13cf299565df6ead1a9d9c8710d56275d402f51dfcdfe14a95c')

package() {
    bsdtar -xf "$srcdir/$_pkgname-$pkgver-1-x86_64.pkg.tar.zst" -C "$pkgdir" \
        --exclude '.PKGINFO' --exclude '.BUILDINFO' --exclude '.MTREE' \
        --exclude '.INSTALL'
}
